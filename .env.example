# Agent 遙測上報專用 API Key (分配給各伺服器 Agent)
API_KEY=change-this-metrics-key

# 儀表板最高權限管理金鑰 (嚴格隔離，禁止與 API_KEY 相同)
ADMIN_API_KEY=change-this-admin-key

# 唯讀 API 與 WebSocket 預設強制驗證
REQUIRE_READ_AUTH=true

# SNMPv3 authPriv 憑證（透過秘密管理機制設定；未設定時 SNMP 探測會失敗關閉）
SNMP_V3_USERNAME=
SNMP_V3_AUTH_PASSWORD=
SNMP_V3_PRIV_PASSWORD=
SNMP_V3_AUTH_PROTOCOL=sha1
SNMP_V3_PRIV_PROTOCOL=aes
SNMP_TIMEOUT_SECONDS=3
SNMP_RETRIES=1
UPS_SSL_CA_PATH=

REDIS_PASSWORD=change-redis-password
REDIS_URL=redis://:change-redis-password@redis:6379/0
SQLITE_PATH=data/metrics.db
SQLITE_TIMEOUT_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=30

HOST=127.0.0.1
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8000
PORT_HTTP=80
PORT_HTTPS=443
ENABLE_HTTP=true
ENABLE_HTTPS=true
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem
